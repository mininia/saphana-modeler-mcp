# SAP HANA 连接配置（复制为 .env 后填写真实值）
# 安全要求：连接信息/用户名/密码 不得以任何形式入库（.env 已 gitignore）
# 下方值为占位符，禁止替换为真实环境值后提交
#
# 生效规则（逐变量）：已存在的环境变量不会被本文件覆盖 —— 只用本文件时请确认
# shell/容器里没有残留的 HANA_* 连接变量；连接目标/凭据跨来源混用时服务会启动告警。
# 查找顺序：工作目录 .env → 项目根 .env（凭据三件套齐备即停）。
# HTTP 模式同样适用（此时 mcp.json 的 env 不参与，见 README「配置参数」）。

# HANA 主机名或 IP 地址
HANA_HOST=hana-host.example

# SQL 端口（**必填**）。2026-10-14 起不再有实例号（HANA_INSTANCE 已删除），端口一律显式给出：
# 那条 3<实例>13/15 的推导只覆盖默认实例与首个租户，非默认租户（如 31041）推不出来，
# 猜错的表现是连到另一套库或每次调用都失败。只接受纯数字。
HANA_PORT=31015

# 连接用户名/密码
HANA_USER=your_user
# 注意：密码含 # 等特殊字符时必须加双引号（如 HANA_PASSWORD="YOUR#PASSWORD"），否则 # 会被当作注释截断
HANA_PASSWORD=your_password

# 连接 Locale（默认 zh），影响服务器端语言/错误消息
HANA_LOCALE=zh

# 租户数据库名（MDC 多租户环境必填，如 SYSTEMDB / HXE 或业务租户名）
HANA_DB_NAME=SYSTEMDB

# TLS 加密连接：默认 true（fail-closed，未显式配置时不允许明文传输凭据/数据）。
# 仅当网络链路可信（如 localhost）且需兼容自签证书时才显式置 false
HANA_TLS=true

# TLS 下是否校验服务器证书：默认 true（防中间人替换证书窃取认证与数据）。
# 内网自签证书环境需跳过校验时显式置 false（应与 HANA_TLS=false 权衡，避免"加密但不认证"）
HANA_SSL_VALIDATE=true

# 默认时区（IANA 名称），默认上海；可在 mcp.json 的 env 中配置覆盖
HANA_TIMEZONE=Asia/Shanghai

# 日志级别：fatal/error/warn/info/debug/trace，默认 info
LOG_LEVEL=info

# 额外允许查询的 schema（逗号分隔，追加到系统 schema 白名单 _SYS_BIC/_SYS_BI/_SYS_REPO/SYS/_SYS_XS/SAPABAP1）
# HANA_READ_SCHEMA=MYSCHEMA,OTHERS

# 允许写操作的仓库包前缀（逗号分隔，含下级子包；大小写不敏感，按大写归一）。
# 空 = 未启用写边界：声明写包的写请求会被运行期闸门以 boundary_off 硬拦（要写就必须显式配置）；
#      只有服务层的包检查是 fail-open（脚本/内部调用不走工具层闸门，拦不到）。
# 非空 = 仅允许列出的包及其子包写操作。
# 例：HANA_WRITE_PACKAGES=ZDEMO,ZDEMO.ZDEMO_SD → 允许 ZDEMO、ZDEMO.X、ZDEMO.ZDEMO_SD.SUB，拒绝其它包。
# 非法包名（如 "ZDEMO." / "*"）会在启动时直接失败，而不是静默变成永不匹配的前缀。
# HANA_WRITE_PACKAGES=ZDEMO1,ZDEMO2.ZDEMO_SD

# XS Classic 设计时 REST 端口（建模写路径直连 HTTP）。默认 8010；非默认实例/租户请显式覆盖。
# 仍不按实例号推导（HANA_INSTANCE 已删除）；只读部署无需关心。
# HANA_XS_PORT=8010

# 本地文件边界（无旋钮，2026-10-14 起）：hana_repo_export 的 saveTo 与 hana_repo_import 的 filePath
# 只接受**服务器工作目录内的相对路径**（客户端拉起时即客户端默认工作区）；绝对路径与 '..' 逃逸一律拒绝。
# 原先的 MCP_LOCAL_ROOT（自定义本地根）已删除：多一档可配范围就多一处「以为隔离了、其实没配」的空间。
# 需要更强的隔离（只允许专用导出目录）请让服务进程以该目录为工作目录启动。
# （存量配置里残留 MCP_LOCAL_ROOT 会命中「未识别环境变量」启动告警。）

# XS 写通道是否使用 HTTPS（默认 false = 明文 HTTP）。XS 通道的 HANA 账号密码/会话 Cookie/CSRF
# 全走明文，HANA_TLS 不覆盖它——必须由网络侧隔离；XS 端点支持 TLS 时置 true 并把 HANA_XS_PORT
# 指向 HTTPS 端口。
# HANA_XS_TLS=true

# XS 设计时 REST 基础路径（默认 /sap/hana/xs/dt/base，一般无需修改）
# HANA_XS_BASE_PATH=/sap/hana/xs/dt/base

# ===== 多 HANA 环境（可选；单环境不需要任何 _ENV_ 变量）=====
# 共用参数沿用上面的原名；命名环境用 HANA_<PARAM>_ENV_<XXXX> 覆盖，未写的字段继承共用值。
# 至少出现一个 _ENV_ 变量才进入多环境模式；只设 LABEL/START/SWITCHABLE 不算多环境。
# LABEL 是 MCP 识别的系统标识（大小写/数字/_/-，最长 32 字符）：基础环境 HANA_LABEL
# （默认 default），命名环境 HANA_LABEL_ENV_<XXXX>（默认 XXXX）。
# HANA_ENV_START / HANA_ENV_SWITCHABLE 用 LABEL，不是 _ENV_ 后面的配置键。
# 只读环境：HANA_ACCESS=readonly（或 HANA_ACCESS_ENV_<XXXX>=readonly）；单环境也生效。
#           拒绝变更类能力；行为只读的 admin 不受影响；SQL 由 HANA_READONLY_SQL 控制。
# 多环境变更类调用必须带 expectedEnvironment=<当前 LABEL>。
# 旧前缀 HANA_ENV_<NAME>_* 与 JSON/YAML 配置文件不支持，出现即启动失败。
#
# 基础环境（示例：中国生产，只读）
# HANA_ACCESS=readonly
# HANA_LABEL=PRD_CN
#
# 命名环境 PRD_EU（只写差异）
# HANA_HOST_ENV_PRD_EU=hana-prd-eu.example
# HANA_USER_ENV_PRD_EU=PRD_EU_READER
# HANA_PASSWORD_ENV_PRD_EU=...
# HANA_DB_NAME_ENV_PRD_EU=PRDDB_EU
# HANA_XS_PORT_ENV_PRD_EU=8000
#
# HANA_ENV_START=PRD_CN
# HANA_ENV_SWITCHABLE=PRD_CN,PRD_EU
# 只读 SQL 策略：select-only（默认）/ deny
# HANA_READONLY_SQL=select-only

# ===== 并发、超时与资源治理 =====
# 目的：防「一个代理拖垮全池」——池位/排队、语句与 XS 请求超时、激活并发全部可配（下列值为默认值）。

# HANA 连接池并发上限（默认 4）：池位 = 到数据库的连接数。
# 部署建议「每个代理一个进程」，N 个代理 = N×该值条 HANA 连接
# HANA_POOL_MAX=4

# 池满后的排队等待超时 ms（默认 30000）：到时仍未拿到连接即以可读错误失败，不会无限期挂住
# HANA_POOL_WAIT_MS=30000

# 排队上限（默认 64）：池满且排队已满时立即失败，防请求无限堆积
# HANA_POOL_MAX_WAITERS=64

# 写路径五条 SQL 语句的语句超时 ms（默认 60000）：存在性检查 / 兜底直写 / 行探测 / 影响半径的下游查询 / REPOSITORY_REST 调用。
# 不设全局默认的理由（hana_sql_analyze 等合法长语句）详见 README「传输方式 → 超时与资源治理」
# HANA_SQL_TIMEOUT_MS=60000

# XS REST 请求默认超时 ms（默认 30000）：覆盖全部走该出口的调用——含激活/更新/校验都要先做的读内容、读元数据
# （一个挂死的 GET 同样占住写路径）；登录/取 CSRF 另有更短的固定超时（10s，无环境变量旋钮）
# HANA_XS_TIMEOUT_MS=30000

# XS Transfer（xfer）导入/导出超时 ms（默认 300000）：整包上传/下载天然慢，单独放宽
# HANA_XS_XFER_TIMEOUT_MS=300000

# 激活并发上限（进程内信号量，默认 2）：激活是重操作（2–10s/次），防多代理并发激活压垮 XS/HANA；
# 与 keyed lock 职责分离（锁管「同对象」、信号量管「全局并发」，不可互相替代）
# HANA_ACTIVATION_CONCURRENCY=2

# ===== 直接执行 HANA SQL（hana_sql_execute；独立第七根工具，sql 组默认关闭）=====
# ⚠️ 工具本身必须先显式启用：HANA_TOOL_GROUPS=sql 或 HANA_TOOL_ALLOW=hana_sql_execute。
#    空 HANA_TOOL_GROUPS 只启用 read/write/admin，**不会**顺带开启 sql；未启用时该能力
#    不进 tools/list、不出现在任何门面描述/索引、任何提示也不提及它。
# 调用时机：仅在用户明确要求执行 SQL 时调用；不用于探测/验证/替代专用工具。
# 安全默认：默认只接受**单条语句 + 单物理行**；显式事务控制与修改会话状态的 SET 一律拒绝；
#          管理类语句（CALL/GRANT/...）默认允许，受数据库账号权限约束；
#          EXPLAIN 始终拒绝（请改用 hana_sql_analyze）；DO 匿名块不支持（请改用 CALL）。
# 服务端不做 schema 级拦截：能访问哪些对象由连接使用的 HANA 账号权限决定。
# maxRows / timeoutMs 是**工具调用参数**（默认 500 行 / 60000ms，范围 1..10000 / 1..3600000），
#          不放环境变量；async=true 时立即返回 taskId，用 hana_task_get 轮询。
# 多行/多语句（同一开关）：服务端在同一条连接上自动开事务，有写时全部成功才 commit、失败 rollback，
#          并在 finally 恢复 autoCommit=true。DDL 在 HANA 可能隐式提交，回滚不保证撤销其效果。
# HANA_SQL_ALLOW_MULTI_STATEMENT=true
# 部署级结果上限（非法/越界值启动即失败）
# HANA_SQL_MAX_RESULT_BYTES=1000000  # 单次结果累计字节上限（1024..52428800）
# HANA_SQL_MAX_STATEMENTS=20         # 单次调用语句条数上限（1..100）

# ===== 工具功能分组与可见性控制 =====
# 详见 README「工具分组与可见性控制」与 docs/mcp-connect.md。
# 四类分组：read（数据读取）、write（写操作）、admin（管理操作：Transfer/Change-Tracking 与系统监视面）、
# sql（直接执行 HANA SQL，**默认关闭**：空配置不会启用它）。
# 前缀 HANA_：与 HANA_WRITE_PACKAGES / HANA_READ_SCHEMA 同类，都是「这个 HANA 面向客户端暴露/放行多少」
# 的部署级范围声明。
# ⚠️ 2026-10-14 复核回退：这三项曾于 2026-10-08 改名 MCP_TOOL_*，现改回 HANA_ 前缀。
#    **无别名层**：MCP_TOOL_* 不再识别，仍写旧名会命中「未识别 HANA_/MCP_/LOG_ 环境变量」启动告警。

# 调用方档案（可选）：name=kinds[:能力glob|glob][;name2=…]，kinds 用 + 连接（read/write/admin/sql；
# sql 只在部署已启用 sql 组时才有意义）。
# 档案只能收紧部署策略；配了本项就必须定义 default（HTTP 无第三段的 Token 与 stdio 进程都落它）。
# 例：MCP_PROFILES="analyst=read;dev=read+write:hana_view_*|hana_metadata_*;default=read"
#MCP_PROFILES=

# 本进程（stdio）使用的档案名（上面定义过的名字），默认 default
#MCP_PROFILE=default

# 进程级归因标签（可选）：写进 envelope 与每条 capability-audit，用于区分"这条记录来自哪套部署"。
# 空 = 不产生该字段
#MCP_AGENT_LABEL=

# 工具层是**两层**：常驻的恒为六个分类门面（hana_system / hana_discovery / hana_data / hana_insights /
# hana_modeling / hana_diagnostics），其余能力默认隐藏。调门面会把**该分类的能力提升进工具面**——
# 此后它们是 tools/list 里的一等工具（带完整 schema、可平铺直调）。要把某类整个拿掉，
# 用下面的 HANA_TOOL_GROUPS / HANA_TOOL_DENY。
# （曾有 MCP_CAPABILITY_TIER2「长尾降级集合」旋钮，随门面制删除——常驻的永远只有六个门面。）

# 单个调用方的**提升预算**（默认 50，与 hana-cli 的 MAX_DYNAMIC_TOOLS 同值）。
# 按**工具数**算，超出时**最旧的那个分类**整体淘汰（FIFO）。本仓当前的规模远低于该预算上限，
# 实际不会触发；它存在的意义是能力增长时不静默失控。
#MCP_CAPABILITY_SURFACE_MAX=50

# 三变量优先级：HANA_TOOL_DENY > HANA_TOOL_ALLOW > HANA_TOOL_GROUPS。
# 全空 = 启用 read/write/admin 三组（向后兼容默认）；**sql 组例外，默认关闭**，需显式启用。

# 启用的分组（逗号分隔）；空 = read/write/admin 全部启用（sql 除外）。
# 例：read,admin → 关闭 write 分组（read 与 admin 档能力仍可见）。注意 admin 档的 hana_repo_import
#      也是写能力：其目标包受 HANA_WRITE_PACKAGES 写边界约束（空白名单时该写被运行期闸门拦下）。
# 启用直接执行 SQL：在 HANA_TOOL_GROUPS 里加 sql（如 read,write,admin,sql），
#      或只配 HANA_TOOL_ALLOW=hana_sql_execute 单独放行。
# 门面层不做限制：六个入口在任何分组下都常驻（只受 HANA_TOOL_DENY 影响）。分组开关只决定
# **能力层**——索引/路由/调用按目标能力的 kind 判。只读部署里 hana_diagnostics 的索引为空、hana_modeling 只剩 read 档的 hana_task_get
# （入口在、里面几乎没有你可用的能力）；越界目标由目标能力自己的判定拦下。
# HANA_TOOL_GROUPS=read

# 强制启用的工具名 glob（即便其分组未启用也注册）；逗号分隔，支持 * 通配。
# 用于在分组开关之外单独放行个别工具。例：HANA_TOOL_ALLOW=hana_some_tool
# HANA_TOOL_ALLOW=

# 强制禁用的工具名 glob（优先级最高，覆盖 allow 与分组）；逗号分隔，支持 * 通配。
# 例：关闭所有预览工具 → HANA_TOOL_DENY=hana_data_preview*
# HANA_TOOL_DENY=

# 工具面省略说明的**调试开关**：置 names 时，门面索引的 surface 说明会列出被隐藏/加载失败的能力名。
# 默认不点名（只说明类别，避免向模型泄漏能力存在性）；排障用完即关。
# HANA_EXPLAIN_SURFACE=names

# ===== 传输方式（默认 stdio；设置 MCP_HTTP_PORT 后切换为 Streamable HTTP）=====

# Streamable HTTP 端口：设置后以 HTTP 模式启动（端点 /mcp，供支持 url 接入的 MCP 客户端使用）。
# 未设置/注释掉 = stdio 传输（默认）；0 = 随机端口
# MCP_HTTP_PORT=3000

# Streamable HTTP 监听地址：默认 127.0.0.1（仅本机，fail-closed）。
# 对外暴露需显式配置（如 0.0.0.0），并同步放行下方两个白名单
# MCP_HTTP_HOST=127.0.0.1

# Streamable HTTP Bearer Token（**已废弃**，保留仅为向后兼容；新部署请只用下方 MCP_HTTP_TOKENS）。
# 等价于 MCP_HTTP_TOKENS="shared:<token>" —— 读入同一张 Token→身份表，401 语义与归因行为不变。
# 计划在下一个大版本删除。设置后所有请求须带 `Authorization: Bearer <token>`（缺失/不匹配 → 401）。
# 默认未设置（回环监听即为访问边界）；对外暴露时强烈建议配置。
# MCP_HTTP_TOKEN=

# 多客户端 Token → 身份映射（可选，逗号分隔的 name:token[:profile]）：
# 用于把每个请求归属到具体客户端——envelope.clientId、审计日志与排障都据此归因。
# 第三段（可选）= 该身份的调用方档案，须在 MCP_PROFILES 中定义（见上）；省略则落默认档案。
# 多客户端共享同一 HANA 技术账号（HANA_USER），仓库侧的修改记录（OWNER/ACTIVATED_BY）
# 只能看到该账号，归属信息只有这里能给；对外共享部署时建议按客户端分配 Token。
# 约束：name 限字母/数字/_.- 且 ≤32 字符；token ≥16 字符且**不得含冒号**（含冒号会被切成档案段）；
#       超过 3 段 / 空段 / name、token 重复或格式非法 → 启动失败（宁失败不静默改义）。
# 可与 MCP_HTTP_TOKEN 并存（后者映射为 shared；该方式已废弃，见上）
# MCP_HTTP_TOKENS=alice:alice-long-random-token:dev,bob:bob-long-random-token

# 多环境 HTTP：无会话 HTTP 不能靠进程级 active；每个 Token 必须绑定一个环境 LABEL。
# 仅 HTTP 模式有效；多环境 HTTP 必填且每个 Token 都要绑定，否则启动失败。
# MCP_HTTP_CLIENT_ENVS=alice:PRD_CN,bob:PRD_EU

# 允许的 Host 头主机名（DNS rebinding 防护；逗号分隔，不含端口，IPv6 带方括号）。
# 默认仅本机名；经对外主机名访问时须追加对应主机名
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 允许的 Origin 主机名（浏览器类客户端防护；逗号分隔，不含 scheme/端口）。
# **未设置时继承 MCP_HTTP_ALLOWED_HOSTS**（通常无需单独配置）；显式置空 = 拒绝一切带 Origin 的请求。
# 无 Origin 头的请求一律放行（非浏览器 MCP 客户端不发 Origin）
# MCP_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# 显式承认「HTTP 对外监听且不配置任何 Bearer Token」的风险（默认 false = 拒绝启动）。
# 非回环监听 + 无 Token 时，任何可达者都能调用全部工具（含写操作）且无法归因，
# 此时写边界/工具分组/schema 白名单全部形同虚设 —— 故默认 fail-closed。
# 确实需要（如已置于带认证的反向代理之后）再显式置 true
# MCP_HTTP_ALLOW_ANONYMOUS=false
