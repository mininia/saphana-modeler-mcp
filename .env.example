# SAP HANA 连接配置（复制为 .env 后填写真实值）
# 安全要求：连接信息/用户名/密码 不得以任何形式入库（.env 已 gitignore）
# 下方值为占位符，禁止替换为真实环境值后提交
#
# 生效规则（逐变量）：已存在的环境变量不会被本文件覆盖 —— 只用本文件时请确认
# shell/容器里没有残留的 HANA_* 连接变量；连接目标/凭据跨来源混用时服务会启动告警。
# 查找顺序：工作目录 .env → 项目根 .env（凭据三件套齐备即停）。
# HTTP 模式同样适用（此时 mcp.json 的 env 不参与，见 README「配置参数」）。

# HANA 主机名或 IP 地址
HANA_HOST=hana-host.example

# 实例号（00-99），用于推导默认 SQL 端口（3<instance>13/15）
HANA_INSTANCE=00

# SQL 端口（可选）。若留空，按实例号自动推导：
# - SYSTEMDB / Single container: 3<instance>13
# - Tenant database (MDC): 3<instance>15
HANA_PORT=

# 连接用户名/密码
HANA_USER=your_user
# 注意：密码含 # 等特殊字符时必须加双引号（如 HANA_PASSWORD="YOUR#PASSWORD"），否则 # 会被当作注释截断
HANA_PASSWORD=your_password

# 连接 Locale（默认 zh_CN），影响服务器端语言/错误消息
HANA_LOCALE=zh_CN

# 租户数据库名（MDC 多租户环境必填，如 SYSTEMDB / HXE 或业务租户名）
HANA_DB_NAME=SYSTEMDB

# TLS 加密连接：默认 true（fail-closed，未显式配置时不允许明文传输凭据/数据）。
# 仅当网络链路可信（如 localhost）且需兼容自签证书时才显式置 false
HANA_TLS=true

# TLS 下是否校验服务器证书：默认 true（防中间人替换证书窃取认证与数据）。
# 内网自签证书环境需跳过校验时显式置 false（应与 HANA_TLS=false 权衡，避免"加密但不认证"）
HANA_SSL_VALIDATE=true

# 默认时区（IANA 名称），默认上海；可在 mcp.json 的 env 中配置覆盖
HANA_TIMEZONE=Asia/Shanghai

# 日志级别：fatal/error/warn/info/debug/trace，默认 info
LOG_LEVEL=info

# 额外允许查询的 schema（逗号分隔，追加到系统 schema 白名单 _SYS_BIC/_SYS_BI/_SYS_REPO/SYS/_SYS_XS/SAPABAP1）
# HANA_SCHEMA_ALLOW=MYSCHEMA,OTHERS

# 允许写操作的仓库包前缀（逗号分隔，含下级子包；大小写不敏感，按大写归一）。
# 空 = 不限制（所有包均可写）；非空 = 仅允许列出的包及其子包写操作。
# 例：HANA_WRITE_PACKAGES=ZDEMO,ZDEMO.ZDEMO_SD → 允许 ZDEMO、ZDEMO.X、ZDEMO.ZDEMO_SD.SUB，拒绝其它包。
# 非法包名（如 "ZDEMO." / "*"）会在启动时直接失败，而不是静默变成永不匹配的前缀。
# HANA_WRITE_PACKAGES=ZDEMO1,ZDEMO2.ZDEMO_SD

# XS Classic 设计时 REST 端口（建模写路径 D1 直连 HTTP）；省略按实例号推导 80<instance>
# HANA_XS_PORT=8010

# XS 设计时 REST 基础路径（默认 /sap/hana/xs/dt/base，一般无需修改）
# HANA_XS_BASE_PATH=/sap/hana/xs/dt/base

# ===== 工具功能分组与可见性控制 =====
# 详见 README「工具分组与可见性控制」与 docs/mcp-connect.md。
# 三类分组：read（数据读取）、write（写操作）、admin（管理操作，当前为占位）。
# 三变量优先级：HANA_TOOL_DENY > HANA_TOOL_ALLOW > HANA_TOOL_GROUPS；全空=全部启用（向后兼容默认）。

# 启用的分组（逗号分隔）；空=不限制（全部分组启用）。
# 例：read,admin → 仅暴露数据读取与管理操作，关闭全部写工具。
# HANA_TOOL_GROUPS=read

# 强制启用的工具名 glob（即便其分组未启用也注册）；逗号分隔，支持 * 通配。
# 用于在分组开关之外单独放行个别工具。例：HANA_TOOL_ALLOW=hana_some_tool
# HANA_TOOL_ALLOW=

# 强制禁用的工具名 glob（优先级最高，覆盖 allow 与分组）；逗号分隔，支持 * 通配。
# 例：关闭所有预览工具 → HANA_TOOL_DENY=hana_data_preview*
# HANA_TOOL_DENY=

# ===== 传输方式（默认 stdio；设置 MCP_HTTP_PORT 后切换为 Streamable HTTP）=====

# Streamable HTTP 端口：设置后以 HTTP 模式启动（端点 /mcp，供支持 url 接入的 MCP 客户端使用）。
# 未设置/注释掉 = stdio 传输（默认）；0 = 随机端口
# MCP_HTTP_PORT=3000

# Streamable HTTP 监听地址：默认 127.0.0.1（仅本机，fail-closed）。
# 对外暴露需显式配置（如 0.0.0.0），并同步放行下方两个白名单
# MCP_HTTP_HOST=127.0.0.1

# Streamable HTTP Bearer Token（**已废弃**，保留仅为向后兼容；新部署请只用下方 MCP_HTTP_TOKENS）。
# 等价于 MCP_HTTP_TOKENS="shared:<token>" —— 读入同一张 Token→身份表，401 语义与归因行为不变。
# 计划在下一个大版本删除。设置后所有请求须带 `Authorization: Bearer <token>`（缺失/不匹配 → 401）。
# 默认未设置（回环监听即为访问边界）；对外暴露时强烈建议配置。
# MCP_HTTP_TOKEN=

# 多客户端 Token → 身份映射（可选，逗号分隔的 name:token）：
# 用于把每个请求归属到具体客户端——envelope.clientId、审计日志与排障都据此归因。
# 多客户端共享同一 HANA 技术账号（HANA_USER），仓库侧的修改记录（OWNER/ACTIVATED_BY）
# 只能看到该账号，归属信息只有这里能给；对外共享部署时建议按客户端分配 Token。
# 约束：name 限字母/数字/_.- 且 ≤32 字符；token ≥16 字符；name/token 重复或格式非法则启动失败。
# 可与 MCP_HTTP_TOKEN 并存（后者映射为 shared；该方式已废弃，见上）
# MCP_HTTP_TOKENS=alice:alice-long-random-token,bob:bob-long-random-token

# 允许的 Host 头主机名（DNS rebinding 防护；逗号分隔，不含端口，IPv6 带方括号）。
# 默认仅本机名；经对外主机名访问时须追加对应主机名
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# 允许的 Origin 主机名（浏览器类客户端防护；逗号分隔，不含 scheme/端口）。
# **未设置时继承 MCP_HTTP_ALLOWED_HOSTS**（通常无需单独配置）；显式置空 = 拒绝一切带 Origin 的请求。
# 无 Origin 头的请求一律放行（非浏览器 MCP 客户端不发 Origin）
# MCP_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]

# 显式承认「HTTP 对外监听且不配置任何 Bearer Token」的风险（默认 false = 拒绝启动）。
# 非回环监听 + 无 Token 时，任何可达者都能调用全部工具（含写操作）且无法归因，
# 此时写边界/工具分组/schema 白名单全部形同虚设 —— 故默认 fail-closed。
# 确实需要（如已置于带认证的反向代理之后）再显式置 true
# MCP_HTTP_ALLOW_ANONYMOUS=false
