# SAP HANA 连接配置示例（复制为 .env；真实值勿入库）
# 查找顺序：工作目录 .env → 项目根 .env；已存在的环境变量不会被覆盖。
# 完整说明见 CONFIG.md。

# ===== 单环境示例 =====
# SQL 端口：必填，纯数字
HANA_HOST=hana-host.example
HANA_PORT=31015
HANA_USER=your_user
HANA_PASSWORD=your_password
# 密码含 # 等特殊字符时用双引号：HANA_PASSWORD="YOUR#PASSWORD"

# 以下均可选（注释值为默认值）
# HANA_LOCALE=zh
# HANA_DB_NAME=SYSTEMDB（MDC 指定租户时填写；非 MDC 可省略）
# HANA_TLS=true
# HANA_SSL_VALIDATE=true
# HANA_TIMEZONE=Asia/Shanghai
# LOG_LEVEL=info

# ===== 写操作与 XS（可选）=====
# 空 = 写请求被 boundary_off 拒绝；非空 = 仅列出的包及子包可写
# HANA_WRITE_PACKAGES=ZDEMO1,ZDEMO2.ZDEMO_SD
# HANA_READ_SCHEMA=MYSCHEMA,OTHER
# XS 设计时 REST 端口，默认 8010；XS 为明文，HANA_TLS 不覆盖
# HANA_XS_PORT=8010
# HANA_XS_TLS=true
# HANA_XS_BASE_PATH=/sap/hana/xs/dt/base

# ===== 多环境示例（可选）=====
# 出现任意 _ENV_ 变量即进入多环境模式；此时扁平连接键（HANA_HOST 等）会启动报错。
# 环境标识 = _ENV_<XXXX> 的 <XXXX>，大小写不敏感，内部大写；不再有 HANA_LABEL。
# 连接参数：每个环境自己写；HOST/PORT/USER/PASSWORD 必填。
# HANA_HOST_ENV_BWD=hana-bwd.example
# HANA_PORT_ENV_BWD=31015
# HANA_USER_ENV_BWD=BWD_USER
# HANA_PASSWORD_ENV_BWD=...
# HANA_TLS_ENV_BWD=false
#
# HANA_HOST_ENV_BWU=hana-bwu.example
# HANA_PORT_ENV_BWU=31015
# HANA_USER_ENV_BWU=BWU_USER
# HANA_PASSWORD_ENV_BWU=...
#
# 策略/授权：扁平 = 所有环境共享；_ENV_ = 覆盖单个环境
# HANA_ACCESS=readonly
# HANA_ACCESS_ENV_BWD=readwrite
# HANA_WRITE_PACKAGES_ENV_BWD=ZDEMO
# HANA_READ_SCHEMA=SHARED_SCHEMA
# HANA_READONLY_SQL=select-only
#
# 启动/可切列表用环境标识（大小写不敏感）
# HANA_ENV_START=BWD
# HANA_ENV_SWITCHABLE=BWD,BWU
# 可选：显式声明模式（自动判断不一致时启动失败）
# HANA_ENV_MODE=multi

# ===== 并发与超时（可选）=====
# HANA_POOL_MAX=4
# HANA_POOL_WAIT_MS=30000
# HANA_POOL_MAX_WAITERS=64
# HANA_SQL_TIMEOUT_MS=60000
# HANA_XS_TIMEOUT_MS=30000
# HANA_XS_XFER_TIMEOUT_MS=300000
# HANA_ACTIVATION_CONCURRENCY=2

# ===== hana_sql_execute（sql 组默认关闭）=====
# 启用：HANA_TOOL_GROUPS=sql 或 HANA_TOOL_ALLOW=hana_sql_execute
# HANA_SQL_ALLOW_MULTI_STATEMENT=false
# HANA_SQL_MAX_RESULT_BYTES=1000000
# HANA_SQL_MAX_STATEMENTS=20

# ===== 工具分组与档案（可选）=====
# 空 = read/write/admin 启用；sql 默认关闭
# HANA_TOOL_GROUPS=read
# HANA_TOOL_ALLOW=
# HANA_TOOL_DENY=
# HANA_EXPLAIN_SURFACE=names
# MCP_PROFILES="analyst=read;dev=read+write:hana_view_*;default=read"
# MCP_PROFILE=default
# MCP_AGENT_LABEL=
# MCP_CAPABILITY_SURFACE_MAX=50

# ===== HTTP 传输（可选；不配 = stdio）=====
# MCP_HTTP_PORT=3000
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_TOKEN=
# MCP_HTTP_TOKENS=alice:alice-long-random-token:dev,bob:bob-long-random-token
# MCP_HTTP_CLIENT_ENVS=alice:PRD_CN,bob:PRD_EU
# MCP_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# MCP_HTTP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
# MCP_HTTP_ALLOW_ANONYMOUS=false
