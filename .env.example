# SAP HANA 连接配置（复制为 .env 后填写真实值）
# 安全要求：连接信息/用户名/密码 不得以任何形式入库（.env 已 gitignore）
# 下方值为占位符，禁止替换为真实环境值后提交

# HANA 主机名或 IP 地址
HANA_HOST=hana-host.example

# 实例号（00-99），用于推导默认 SQL 端口（3<instance>13/15）
HANA_INSTANCE=00

# SQL 端口（可选）。若留空，按实例号自动推导：
# - SYSTEMDB / Single container: 3<instance>13
# - Tenant database (MDC): 3<instance>15
HANA_PORT=

# 连接用户名/密码
HANA_USER=your_user
# 注意：密码含 # 等特殊字符时必须加双引号（如 HANA_PASSWORD="YOUR#PASSWORD"），否则 # 会被当作注释截断
HANA_PASSWORD=your_password

# 连接 Locale（默认 zh_CN），影响服务器端语言/错误消息
HANA_LOCALE=zh_CN

# 租户数据库名（MDC 多租户环境必填，如 SYSTEMDB / HXE 或业务租户名）
HANA_DB_NAME=SYSTEMDB

# TLS 加密连接：默认 true（fail-closed，未显式配置时不允许明文传输凭据/数据）。
# 仅当网络链路可信（如 localhost）且需兼容自签证书时才显式置 false
HANA_TLS=true

# TLS 下是否校验服务器证书：默认 true（防中间人替换证书窃取认证与数据）。
# 内网自签证书环境需跳过校验时显式置 false（应与 HANA_TLS=false 权衡，避免"加密但不认证"）
HANA_SSL_VALIDATE=true

# 默认时区（IANA 名称），默认上海；可在 mcp.json 的 env 中配置覆盖
HANA_TIMEZONE=Asia/Shanghai

# 日志级别：fatal/error/warn/info/debug/trace，默认 info
LOG_LEVEL=info

# 额外允许查询的 schema（逗号分隔，追加到系统 schema 白名单 _SYS_BIC/_SYS_BI/_SYS_REPO/SYS/_SYS_XS/SAPABAP1）
# HANA_SCHEMA_ALLOW=MYSCHEMA,OTHERS

# XS Classic 设计时 REST 端口（建模写路径 D1 直连 HTTP）；省略按实例号推导 80<instance>
# HANA_XS_PORT=8010

# XS 设计时 REST 基础路径（默认 /sap/hana/xs/dt/base，一般无需修改）
# HANA_XS_BASE_PATH=/sap/hana/xs/dt/base

# ===== 工具功能分组与可见性控制 =====
# 详见 README「工具分组与可见性控制」与 docs/mcp-connect.md。
# 三类分组：read（数据读取）、write（写操作）、admin（管理操作，当前为占位）。
# 三变量优先级：HANA_TOOL_DENY > HANA_TOOL_ALLOW > HANA_TOOL_GROUPS；全空=全部启用（向后兼容默认）。

# 启用的分组（逗号分隔）；空=不限制（全部分组启用）。
# 例：read,admin → 仅暴露数据读取与管理操作，关闭全部写工具。
# HANA_TOOL_GROUPS=read

# 强制启用的工具名 glob（即便其分组未启用也注册）；逗号分隔，支持 * 通配。
# 用于在分组开关之外单独放行个别工具。例：HANA_TOOL_ALLOW=hana_some_tool
# HANA_TOOL_ALLOW=

# 强制禁用的工具名 glob（优先级最高，覆盖 allow 与分组）；逗号分隔，支持 * 通配。
# 例：关闭所有预览工具 → HANA_TOOL_DENY=hana_data_preview*
# HANA_TOOL_DENY=

# 预留：Streamable HTTP transport 端口（当前 stdio 传输，仅预留配置位）
# MCP_HTTP_PORT=3000
